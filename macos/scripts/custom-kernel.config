# M14b：arm64 custom kernel config fragment（virtio-gpu & DRM KMS）。
# 站在 defconfig 基础上附加；不需要 modules 加载（builtin=y）。

CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU_KMS=y
CONFIG_DRM_VIRTIO_GEM_FRAMEBUFFER_HELPER=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=n
CONFIG_FB_SYS_FILLRECT=y
CONFIG_FB_SYS_COPYAREA=y
CONFIG_FB_SYS_IMAGEBLIT=y
CONFIG_SYS_FILLRECT=y
CONFIG_SYS_COPYAREA=y
CONFIG_SYS_IMAGEBLIT=y
CONFIG_DRM_FBDEV_EMULATION=y
# debug探获（本阶段）
CONFIG_DRM_DEBUG_MODESET_LOCK=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# VZ virt 平台必备驱动（全部 builtin，defconfig 默认不含）
CONFIG_VIRTIO_BLK=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_HVC_DRIVER=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_CGROUPS=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_MEMCG=y
CONFIG_MEMCG_V1=n
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CC_STACKPROTECTOR_STRONG=y
CONFIG_LOCK_KERNEL=y
CONFIG_PANIC_ON_OOPS=n
CONFIG_PANIC_TIMEOUT=5
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_FB=y

# M18：内核级纵深（Landlock 路径面 + seccomp-bpf syscall 面）
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock"
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# selinux 翻装载的信息（避免 build 依赖问题）
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_AUDIT is not set
